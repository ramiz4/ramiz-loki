{
  "name": "ramiz-loki",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://ramiz4.github.io/ramiz-loki",
  "engines": {
    "node": ">=20.17.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm vite",
    "build": "pnpm vite build",
    "lint": "pnpm eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "pnpm eslint --fix \"src/**/*.{js,jsx,ts,tsx}\" && pnpm prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "preview": "pnpm vite preview",
    "test": "pnpm cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test jest",
    "test:watch": "pnpm cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test jest --watch",
    "test:coverage": "pnpm cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test jest --coverage",
    "predeploy": "pnpm run build",
    "deploy": "pnpm gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.8.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "latest",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-unused-imports": "^4.3.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "postcss": "latest",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4"
    }
  }
}
